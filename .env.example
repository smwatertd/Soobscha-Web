# Шаблон переменных окружения (этот файл можно хранить в репозитории).
#
# Рабочие значения:
#   .env.dev  — локальная разработка (npm run dev, режим Vite: dev)
#   .env.prod — production-сборка (npm run build, режим Vite: prod)
#
# Скопируйте этот файл в .env.dev / .env.prod и подставьте ключи.
# Файлы .env.dev и .env.prod в git не коммитятся.

# Яндекс.Карты — JS API (карта на странице соцзаявки)
# https://developer.tech.yandex.ru/services/
VITE_YANDEX_MAPS_JS_API_KEY=

# HTTP Геокодер (зарезервировано под будущие сценарии, например бэкенд)
VITE_YANDEX_GEOCODER_API_KEY=
